[user]
  name = Nelson Fleig
{{- /* email lives in the machine's chezmoi.toml, kept out of this public repo. On Coder a `coder secret` writes that file; Codespaces supplies the email itself. */}}
{{- if hasKey . "email" }}
  email = {{ .email }}
{{- end }}
[pull]
  rebase = true
[push]
  default = current
[init]
  defaultBranch = main
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
